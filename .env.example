# Copiar a .env para uso local. Dejar vacío lo que todavía no se ha conectado.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# SMTP queda deshabilitado hasta la conexión final del correo personal.
NOTIFICATIONS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
NOTIFICATION_TO=

# Acceso local del editor n8n; no exponer este servicio en Internet.
GENERIC_TIMEZONE=America/Bogota
TZ=America/Bogota
