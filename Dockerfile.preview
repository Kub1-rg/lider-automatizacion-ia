FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        fonts-liberation \
        libffi8 \
        libharfbuzz-subset0 \
        libjpeg62-turbo \
        libpango-1.0-0 \
        libpangoft2-1.0-0 \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --no-cache-dir \
    weasyprint==65.1 \
    PyMuPDF==1.26.3 \
    Pillow==11.3.0

WORKDIR /app
COPY scripts/render_email_previews.py /app/render_email_previews.py

ENTRYPOINT ["python", "/app/render_email_previews.py"]
